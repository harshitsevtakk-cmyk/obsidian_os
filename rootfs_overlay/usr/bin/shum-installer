#!/usr/bin/env python3
import tkinter as tk
from tkinter import messagebox, ttk
import os

class ShumInstallerApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Shum OS Setup")
        self.root.geometry("600x400")
        self.root.configure(bg="#005a9e")

        title_label = tk.Label(root, text="Shum OS Installation Wizard", font=("Helvetica", 18, "bold"), fg="white", bg="#005a9e")
        title_label.pack(pady=20)

        card = tk.Frame(root, bg="#ffffff", padx=30, pady=30)
        card.pack(fill="both", expand=True, padx=40, pady=20)

        info_label = tk.Label(card, text="Select target drive to install Shum OS:", font=("Helvetica", 11), bg="#ffffff")
        info_label.pack(anchor="w", pady=(0, 10))

        self.disk_combo = ttk.Combobox(card, values=["/dev/sda (Virtual Hard Disk)", "/dev/nvme0n1"], state="readonly")
        self.disk_combo.current(0)
        self.disk_combo.pack(fill="x", pady=10)

        btn_frame = tk.Frame(card, bg="#ffffff")
        btn_frame.pack(fill="x", side="bottom", pady=(20, 0))

        install_btn = tk.Button(btn_frame, text="Install Now", bg="#0078d4", fg="white", font=("Helvetica", 10, "bold"), relief="flat", padx=15, pady=8, command=self.start_install)
        install_btn.pack(side="right")

    def start_install(self):
        target = self.disk_combo.get().split()[0]
        if messagebox.askyesno("Confirm Installation", f"Are you sure you want to format {target} and install Shum OS?"):
            os.system(f"mke2fs -F {target} && mount {target} /mnt && cp -a /rootfs/* /mnt/")
            messagebox.showinfo("Success", "Shum OS installed successfully! Rebooting...")
            os.system("reboot")

if __name__ == "__main__":
    root = tk.Tk()
    app = ShumInstallerApp(root)
    root.mainloop()
